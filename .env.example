# Application
APP_NAME=Order Processing System
APP_ENV=development
APP_PORT=8080

# Database - Development
# Host port for the Docker postgres service. If a native PostgreSQL already
# listens on 5432 (e.g. a Windows service), use another port such as 5434,
# otherwise the API silently connects to the native server instead of the
# container that Debezium reads.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=order_processing
DB_SSLMODE=disable

# Database - Testing
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_NAME=order_processing_test
TEST_DB_SSLMODE=disable

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay - Integration / Test Configuration
TEST_RAZORPAY_KEY_ID=
TEST_RAZORPAY_KEY_SECRET=
TEST_RAZORPAY_WEBHOOK_SECRET=

# JWT
JWT_SECRET=your_secret_key
JWT_EXPIRATION=24h
TEST_JWT_SECRET=integration_test_jwt_secret

# Testing
ENABLE_DB_TESTS=1

# Logging
LOG_LEVEL=debug

# OpenTelemetry
OTEL_SERVICE_NAME=enterprise-order-processing
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Kafka
KAFKA_BROKERS=localhost:9092
# Comma-separated Debezium topics consumed by the API (<topic.prefix>.<schema>.<table>)
KAFKA_CDC_TOPIC=order-processing.public.categories,order-processing.public.orders,order-processing.public.inventories
KAFKA_CDC_GROUP_ID=order-processing-cdc-consumer
KAFKA_MIN_BYTES=1
KAFKA_MAX_BYTES=10000000
KAFKA_MAX_WAIT=1s
