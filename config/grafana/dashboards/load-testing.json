{
  "uid": "order-processing-load-testing",
  "title": "Order Processing - Load Testing",
  "tags": ["order-processing", "load-testing"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [
    { "name": "route", "type": "query", "label": "Route", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "query": "label_values(order_processing_http_requests_total, route)", "includeAll": true, "allValue": ".*", "refresh": 1, "current": { "text": "All", "value": ".*" } },
    { "name": "method", "type": "query", "label": "Method", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "query": "label_values(order_processing_http_requests_total, method)", "includeAll": true, "allValue": ".*", "refresh": 1, "current": { "text": "All", "value": ".*" } },
    { "name": "status", "type": "query", "label": "Status", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "query": "label_values(order_processing_http_requests_total, status)", "includeAll": true, "allValue": ".*", "refresh": 1, "current": { "text": "All", "value": ".*" } }
  ] },
  "panels": [
    { "id": 1, "type": "row", "title": "Traffic", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    { "id": 2, "type": "timeseries", "title": "Request Rate", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "sum(rate(order_processing_http_requests_total{route=~\"$route\",method=~\"$method\",status=~\"$status\"}[1m]))", "legendFormat": "requests/sec", "refId": "A" }] },
    { "id": 3, "type": "timeseries", "title": "Requests by Route", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "sum by (route) (rate(order_processing_http_requests_total{route=~\"$route\",method=~\"$method\",status=~\"$status\"}[1m]))", "legendFormat": "{{route}}", "refId": "A" }] },
    { "id": 4, "type": "timeseries", "title": "Requests by HTTP Status", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "sum by (status) (rate(order_processing_http_requests_total{route=~\"$route\",method=~\"$method\",status=~\"$status\"}[1m]))", "legendFormat": "{{status}}", "refId": "A" }] },
    { "id": 5, "type": "row", "title": "Latency", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "collapsed": false, "panels": [] },
    { "id": 6, "type": "timeseries", "title": "P50 / P95 / P99 (seconds)", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [
      { "expr": "histogram_quantile(0.50, sum by (le) (rate(order_processing_http_request_duration_seconds_bucket{route=~\"$route\",method=~\"$method\",status=~\"$status\"}[5m])))", "legendFormat": "P50", "refId": "A" },
      { "expr": "histogram_quantile(0.95, sum by (le) (rate(order_processing_http_request_duration_seconds_bucket{route=~\"$route\",method=~\"$method\",status=~\"$status\"}[5m])))", "legendFormat": "P95", "refId": "B" },
      { "expr": "histogram_quantile(0.99, sum by (le) (rate(order_processing_http_request_duration_seconds_bucket{route=~\"$route\",method=~\"$method\",status=~\"$status\"}[5m])))", "legendFormat": "P99", "refId": "C" }
    ] },
    { "id": 7, "type": "row", "title": "Errors", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "collapsed": false, "panels": [] },
    { "id": 8, "type": "timeseries", "title": "Error Rate (5xx / sec)", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "sum(rate(order_processing_http_requests_total{status=~\"5..\",route=~\"$route\",method=~\"$method\"}[1m]))", "legendFormat": "5xx/sec", "refId": "A" }] },
    { "id": 9, "type": "timeseries", "title": "4xx Rate", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "sum(rate(order_processing_http_requests_total{status=~\"4..\",route=~\"$route\",method=~\"$method\"}[1m]))", "legendFormat": "4xx/sec", "refId": "A" }] },
    { "id": 10, "type": "timeseries", "title": "5xx Error Percentage", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "100 * sum(rate(order_processing_http_requests_total{status=~\"5..\",route=~\"$route\",method=~\"$method\"}[1m])) / clamp_min(sum(rate(order_processing_http_requests_total{route=~\"$route\",method=~\"$method\",status=~\"$status\"}[1m])), 1e-9)", "legendFormat": "5xx %", "refId": "A" }] },
    { "id": 11, "type": "row", "title": "Go Runtime", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "collapsed": false, "panels": [] },
    { "id": 12, "type": "timeseries", "title": "Process CPU (cores)", "gridPos": { "h": 8, "w": 6, "x": 0, "y": 28 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "CPU", "refId": "A" }] },
    { "id": 13, "type": "timeseries", "title": "Memory", "gridPos": { "h": 8, "w": 6, "x": 6, "y": 28 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "go_memstats_heap_alloc_bytes", "legendFormat": "Heap allocated", "refId": "A" }, { "expr": "process_resident_memory_bytes", "legendFormat": "RSS", "refId": "B" }] },
    { "id": 14, "type": "timeseries", "title": "Goroutines", "gridPos": { "h": 8, "w": 6, "x": 12, "y": 28 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "go_goroutines", "legendFormat": "goroutines", "refId": "A" }] },
    { "id": 15, "type": "timeseries", "title": "In-flight Requests", "gridPos": { "h": 8, "w": 6, "x": 18, "y": 28 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "sum(order_processing_http_requests_in_flight{route=~\"$route\",method=~\"$method\"})", "legendFormat": "requests", "refId": "A" }] },
    { "id": 16, "type": "row", "title": "Database Pool", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }, "collapsed": false, "panels": [] },
    { "id": 17, "type": "timeseries", "title": "DB Open / In-use / Idle Connections", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "order_processing_db_open_connections", "legendFormat": "Open", "refId": "A" }, { "expr": "order_processing_db_in_use_connections", "legendFormat": "In-use", "refId": "B" }, { "expr": "order_processing_db_idle_connections", "legendFormat": "Idle", "refId": "C" }] },
    { "id": 18, "type": "timeseries", "title": "DB Wait Count (total increase / sec)", "gridPos": { "h": 8, "w": 6, "x": 12, "y": 37 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "rate(order_processing_db_wait_count_total[1m])", "legendFormat": "waits/sec", "refId": "A" }] },
    { "id": 19, "type": "timeseries", "title": "DB Wait Duration (seconds / sec)", "gridPos": { "h": 8, "w": 6, "x": 18, "y": 37 }, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "targets": [{ "expr": "rate(order_processing_db_wait_duration_seconds_total[1m])", "legendFormat": "wait seconds/sec", "refId": "A" }] },
    { "id": 20, "type": "row", "title": "CDC / Event System", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 }, "collapsed": false, "panels": [] },
    { "id": 21, "type": "text", "title": "CDC metrics unavailable", "gridPos": { "h": 4, "w": 24, "x": 0, "y": 46 }, "options": { "mode": "markdown", "content": "The repository does not currently expose Kafka, Debezium, consumer throughput, or consumer lag metrics. No CDC panels are fabricated. See LOAD_TESTING.md for the current pipeline limitations." } }
  ],
  "annotations": { "list": [] }
}
